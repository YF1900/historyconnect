{
  "name": "historyconnect",
  "version": "0.1.0",
  "private": true,
  "description": "興味のあるテーマから日本の歴史を探究できるスマートフォン向けWebアプリ",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build-library && npm run check-data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "build-library": "node --experimental-strip-types --no-warnings scripts/build-library.ts",
    "check-data": "node --experimental-strip-types --no-warnings scripts/check-data.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YF1900/historyconnect.git"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
